# Public URL of the site (used for SEO + QR codes fallback)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Lead delivery (configure at least one; otherwise leads only appear in Vercel logs) ──

# Any webhook: Google Sheets Apps Script, Zapier, Make, n8n, HubSpot…
LEAD_WEBHOOK_URL=

# Email notifications via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=you@example.com
# Must be a domain verified in Resend (onboarding@resend.dev works for testing)
LEAD_FROM_EMAIL=Alfastays <leads@your-domain.com>
