# Public URL of the site (used for SEO, emails and QR codes)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Lead emails over SMTP ──
# Use a dedicated ALFA Stays mailbox for sending (e.g. a Gmail/Workspace account with an App Password,
# Zoho Mail, or your domain's email). Never commit real values — set them in Vercel → Settings → Environment Variables.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# Optional: defaults to SMTP_USER / "ALFA Stays"
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ALFA Stays

# Inbox(es) that receive booking requests, enquiries and feedback (comma-separated)
LEAD_NOTIFY_EMAIL=

# ── Optional: also send every lead as JSON to Google Sheets (Apps Script), Zapier, Make, n8n or a CRM ──
LEAD_WEBHOOK_URL=
